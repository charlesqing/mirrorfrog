# Cloudflare Pages _redirects
# Format: <source> <target> <status>

# Handle /zh-Hans/* URLs — Docusaurus 默认语言产物在根目录，不做重复前缀
/zh-Hans/*  /:splat  200

# Trailing slash normalization for SEO
/docs/*  /docs/:splat  200
/blog/*  /blog/:splat  200

# SPA fallback for client-side routing
/*  /index.html  200
