# ================================
# MirrorFrog - AI 算力卡百科
# Docusaurus 项目 .gitignore
# ================================

# --- 依赖（必须忽略！）---
node_modules/
.npm/
.yarn/

# --- 构建产物（必须忽略！）---
build/
dist/

# --- Docusaurus 缓存 ---
.docusaurus/
.cache/

# --- 环境变量（安全！） ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- 日志文件 ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dev.log
build-stderr.log

# --- 系统文件 ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- 编辑器/IDE ---
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains IDE (IntelliJ/WebStorm)
.idea/
*.iml
*.iws

# Vim
*.swp
*.swo
*.swn

# Sublime Text
*.sublime-workspace
*.sublime-project

# Atom
.atom/

# --- 临时文件 ---
*.tmp
*.temp
*.bak
*.cache
*.pid

# --- 测试覆盖率 ---
coverage/
.nyc_output/
*.lcov

# --- 自定义忽略（项目特定）---
# 临时脚本（如果存在）
scripts/temp/
*.test.js
*.spec.js

# 备份文件
*.backup
*.bak~
.workbuddy/
